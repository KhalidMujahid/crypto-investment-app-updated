<%
  const clientNav = [
    { name: 'Dashboard', href: '/client/dashboard', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.5 1.5 0 012.122 0L22.5 12M4.5 9.75v10.125a1.125 1.125 0 001.125 1.125H9.75v-4.875a1.125 1.125 0 011.125-1.125h2.25a1.125 1.125 0 011.125 1.125V21h4.125a1.125 1.125 0 001.125-1.125V9.75M8.25 21h8.25"/>' },
    { name: 'Transactions', href: '/client/transactions', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>' },
    { name: 'Withdraw', href: '/client/withdraw', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75"/>' },
    { name: 'Alerts', href: '/client/notifications', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>' },
    { name: 'Profile', href: '/client/profile', icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>' },
  ];
  const initials = ((user && user.firstName ? user.firstName[0] : '') + (user && user.lastName ? user.lastName[0] : '')).toUpperCase();
%>
<div x-data="{ notifOpen: false, profileOpen: false }" class="min-h-screen">

  <!-- Sidebar (desktop) -->
  <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 lg:flex">

    <div class="flex h-16 items-center gap-2.5 border-b border-slate-200 px-5 dark:border-slate-800">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-sm font-bold text-white">AT</span>
      <div class="leading-tight">
        <p class="text-sm font-semibold text-slate-900 dark:text-white">Advanced Trading</p>
        <p class="text-xs text-slate-400">Client Portal</p>
      </div>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
      <% clientNav.forEach(function (link) { %>
        <a href="<%= link.href %>" data-nav class="nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><%- link.icon %></svg>
          <span><%= link.name === 'Alerts' ? 'Notifications' : link.name %></span>
        </a>
      <% }); %>
    </nav>

    <div class="border-t border-slate-200 p-3 dark:border-slate-800">
      <div class="flex items-center gap-3 rounded-xl px-2 py-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white"><%= initials %></span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-slate-900 dark:text-white"><%= user.firstName %> <%= user.lastName %></p>
          <p class="truncate text-xs text-slate-400"><%= user.email %></p>
        </div>
      </div>
      <a href="/logout" class="nav-link mt-1 text-rose-600 hover:bg-rose-50 hover:text-rose-700 dark:text-rose-400 dark:hover:bg-rose-500/10 dark:hover:text-rose-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H3"/></svg>
        <span>Sign out</span>
      </a>
    </div>
  </aside>

  <!-- Content wrapper (pb clears the mobile tab bar) -->
  <div class="pb-24 lg:pb-0 lg:pl-64">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
      <div class="flex h-16 items-center gap-3 px-4 sm:px-6 lg:px-8">

        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-[11px] font-bold text-white lg:hidden">AT</span>

        <h1 class="min-w-0 flex-1 truncate text-base font-semibold text-slate-900 dark:text-white"><%= typeof title !== 'undefined' ? title : '' %></h1>

        <button onclick="toggleTheme()" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white" title="Toggle theme">
          <span class="sr-only">Toggle theme</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
        </button>

        <!-- Notifications (desktop) -->
        <div class="relative hidden lg:block">
          <button @click="notifOpen = !notifOpen" @click.away="notifOpen = false" class="relative rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
            <span class="sr-only">Notifications</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>
            <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white dark:ring-slate-950"></span>
          </button>

          <div x-cloak x-show="notifOpen" x-transition
               class="absolute right-0 mt-2 w-80 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Notifications</h3>
              <a href="/client/notifications" class="text-xs font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">View all</a>
            </div>
            <div id="notifications-list" class="max-h-72 overflow-y-auto">
              <div class="px-4 py-6 text-center text-sm text-slate-400">Loading…</div>
            </div>
          </div>
        </div>

        <!-- Profile (desktop) -->
        <div class="relative hidden lg:block">
          <button @click="profileOpen = !profileOpen" @click.away="profileOpen = false" class="flex items-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/60">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white"><%= initials %></span>
          </button>

          <div x-cloak x-show="profileOpen" x-transition
               class="absolute right-0 mt-2 w-56 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
            <div class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">
              <p class="truncate text-sm font-semibold text-slate-900 dark:text-white"><%= user.firstName %> <%= user.lastName %></p>
              <p class="truncate text-xs text-slate-400"><%= user.email %></p>
            </div>
            <div class="p-1.5">
              <a href="/client/profile" class="block rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Your profile</a>
              <a href="/client/notifications" class="block rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Notifications</a>
              <a href="/logout" class="block rounded-lg px-3 py-2 text-sm text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-500/10">Sign out</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Bottom tab bar (mobile) -->
    <nav class="tabbar">
      <div class="tabbar-inner">
        <% clientNav.forEach(function (tab) { %>
          <a href="<%= tab.href %>" data-nav class="tab">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><%- tab.icon %></svg>
            <span><%= tab.name %></span>
          </a>
        <% }); %>
      </div>
    </nav>

    <script>
      (function () {
        function markActive() {
          var path = window.location.pathname.replace(/\/+$/, '') || '/';
          document.querySelectorAll('[data-nav]').forEach(function (a) {
            var href = a.getAttribute('href').replace(/\/+$/, '') || '/';
            if (href === path) a.classList.add('is-active');
          });
        }
        document.addEventListener('DOMContentLoaded', function () {
          markActive();
          fetch('/client/notifications/data')
            .then(function (res) { return res.json(); })
            .then(function (notifications) {
              var container = document.getElementById('notifications-list');
              if (!container) return;
              if (!notifications.length) {
                container.innerHTML = '<div class="px-4 py-6 text-center text-sm text-slate-400">No notifications yet</div>';
                return;
              }
              container.innerHTML = notifications.map(function (n) {
                return '<a href="/client/notifications" class="block border-b border-slate-100 px-4 py-3 text-sm last:border-0 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/60 ' + (n.read ? '' : 'bg-brand-50/50 dark:bg-brand-500/5') + '">' +
                  '<div class="font-medium text-slate-800 dark:text-slate-100">' + n.title + '</div>' +
                  '<div class="mt-0.5 line-clamp-2 text-slate-500 dark:text-slate-400">' + n.message + '</div>' +
                  '<div class="mt-1 text-xs text-slate-400">' + new Date(n.createdAt).toLocaleString() + '</div>' +
                '</a>';
              }).join('');
            })
            .catch(function () {
              var container = document.getElementById('notifications-list');
              if (container) container.innerHTML = '<div class="px-4 py-6 text-center text-sm text-slate-400">Could not load notifications</div>';
            });
        });
      })();
    </script>
