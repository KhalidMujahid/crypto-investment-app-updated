<%- include('../partials/head', { title: title, bodyClass: 'bg-slate-100 dark:bg-slate-950' }) %>

<main class="flex min-h-screen">

  <!-- Brand panel -->
  <section class="relative hidden w-1/2 overflow-hidden bg-slate-900 lg:flex lg:flex-col lg:justify-between">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_60%_at_30%_20%,rgba(79,70,229,0.45),transparent)]"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full bg-brand-600/30 blur-3xl"></div>

    <div class="relative z-10 flex items-center gap-3 px-10 pt-10">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-sm font-bold text-white ring-1 ring-white/20">AT</span>
      <span class="text-sm font-semibold text-white">Advanced Trading</span>
    </div>

    <div class="relative z-10 px-10 pb-6">
      <h1 class="max-w-md text-3xl font-bold leading-tight text-white">Everything you need to grow, in one place.</h1>
      <ul class="mt-8 max-w-md space-y-4 text-sm text-slate-300">
        <li class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          Portfolio tracking across every asset
        </li>
        <li class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          Secure withdrawals with PIN protection
        </li>
        <li class="flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          Verified identity, protected account
        </li>
      </ul>
    </div>
  </section>

  <!-- Form panel -->
  <section class="flex w-full items-center justify-center px-6 py-12 lg:w-1/2">
    <div class="w-full max-w-sm">

      <div class="mb-8 lg:hidden">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-sm font-bold text-white">AT</span>
      </div>

      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Create your account</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Already registered?
        <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">Sign in</a>
      </p>

      <% if (success && success.length > 0) { %>
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300"><%= success %></div>
      <% } %>
      <% if (error && error.length > 0) { %>
        <div class="mt-6 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300"><%= error %></div>
      <% } %>

      <form class="mt-8 space-y-4" action="/register" method="POST" onsubmit="submitRegister()">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="firstName" class="label">First name</label>
            <input id="firstName" name="firstName" type="text" autocomplete="given-name" required class="input" placeholder="Jane"
                   value="<%= typeof firstName !== 'undefined' ? firstName : '' %>" />
          </div>
          <div>
            <label for="lastName" class="label">Last name</label>
            <input id="lastName" name="lastName" type="text" autocomplete="family-name" required class="input" placeholder="Doe"
                   value="<%= typeof lastName !== 'undefined' ? lastName : '' %>" />
          </div>
        </div>

        <div>
          <label for="email" class="label">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="input" placeholder="you@example.com"
                 value="<%= typeof email !== 'undefined' ? email : '' %>" />
        </div>

        <div>
          <label for="password" class="label">Password</label>
          <div class="relative">
            <input id="password" name="password" type="password" autocomplete="new-password" required class="input pr-11" placeholder="Create a password" />
            <button type="button" onclick="togglePassword('password','password-toggle')" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
              <span class="sr-only">Show password</span>
              <svg id="password-toggle" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </button>
          </div>
        </div>

        <div>
          <label for="confirmPassword" class="label">Confirm password</label>
          <div class="relative">
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required class="input pr-11" placeholder="Repeat your password" />
            <button type="button" onclick="togglePassword('confirmPassword','confirm-toggle')" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
              <span class="sr-only">Show password</span>
              <svg id="confirm-toggle" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </button>
          </div>
        </div>

        <label class="flex items-start gap-2 pt-1 text-sm text-slate-600 dark:text-slate-300">
          <input id="agreeTerms" name="agreeTerms" type="checkbox" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500/40 dark:border-slate-600 dark:bg-slate-900">
          <span>I agree to the <a href="#" class="font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">Terms and Conditions</a></span>
        </label>

        <button id="register-btn" type="submit" class="btn btn-primary w-full">
          <span id="btn-text">Create account</span>
          <span id="btn-loader" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
        </button>
      </form>
    </div>
  </section>
</main>

<script>
  var EYE_OPEN = '<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />';
  var EYE_CLOSED = '<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />';

  function togglePassword(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon = document.getElementById(iconId);
    var show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    icon.innerHTML = show ? EYE_CLOSED : EYE_OPEN;
  }

  function submitRegister() {
    var btn = document.getElementById('register-btn');
    btn.disabled = true;
    document.getElementById('btn-text').textContent = 'Creating account…';
    document.getElementById('btn-loader').classList.remove('hidden');
  }
</script>
</body>
</html>
