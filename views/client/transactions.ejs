<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Transactions</h2>
      <p class="page-sub">Every deposit, withdrawal and movement on your account.</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-6">
    <div class="card-body">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div>
          <label class="label">Type</label>
          <select class="input">
            <option value="">All types</option>
            <option value="deposit">Deposit</option>
            <option value="withdrawal">Withdrawal</option>
            <option value="trade">Trade</option>
            <option value="staking">Staking</option>
          </select>
        </div>
        <div>
          <label class="label">Asset</label>
          <select class="input">
            <option value="">All assets</option>
            <option value="BTC">Bitcoin (BTC)</option>
            <option value="ETH">Ethereum (ETH)</option>
            <option value="USDT">USDT</option>
            <option value="ADA">Cardano (ADA)</option>
          </select>
        </div>
        <div>
          <label class="label">Status</label>
          <select class="input">
            <option value="">All statuses</option>
            <option value="completed">Completed</option>
            <option value="pending">Pending</option>
            <option value="processing">Processing</option>
            <option value="failed">Failed</option>
          </select>
        </div>
        <div>
          <label class="label">Date range</label>
          <select class="input">
            <option value="7">Last 7 days</option>
            <option value="30">Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="365">Last year</option>
            <option value="all">All time</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">All transactions</h3>
      <span class="text-sm muted"><%= total %> record<%= total === 1 ? '' : 's' %></span>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Asset</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr><td colspan="5" class="text-center muted">No transactions found.</td></tr>
          <% } %>
          <% transactions.forEach(function (transaction) { %>
            <tr>
              <td class="whitespace-nowrap muted"><%= new Date(transaction.createdAt).toLocaleDateString() %></td>
              <td>
                <span class="badge <%= transaction.type === 'deposit' ? 'badge-success' : transaction.type === 'withdrawal' ? 'badge-danger' : 'badge-info' %>"><%= transaction.type %></span>
              </td>
              <td class="font-medium text-slate-900 dark:text-white"><%= transaction.asset %></td>
              <td><%= transaction.amount %></td>
              <td>
                <span class="badge <%= transaction.status === 'completed' ? 'badge-success' : transaction.status === 'pending' ? 'badge-warning' : transaction.status === 'processing' ? 'badge-info' : 'badge-danger' %>"><%= transaction.status %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 px-5 py-4 dark:border-slate-800">
        <p class="text-sm muted">Page <%= currentPage %> of <%= totalPages %></p>
        <div class="flex items-center gap-1">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>" class="btn btn-secondary btn-sm">Previous</a>
          <% } %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>" class="btn btn-sm <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %>"><%= i %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>" class="btn btn-secondary btn-sm">Next</a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
