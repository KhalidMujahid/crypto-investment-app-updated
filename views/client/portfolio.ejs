<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Portfolio Overview</h1>
        <div class="flex space-x-4">
            <button class="bg-crypto-blue text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                Add Funds
            </button>
        </div>
    </div>

    <!-- Portfolio Summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Total Balance</h3>
                <span class="text-2xl font-bold text-crypto-green">$12,458.32</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">+2.5% today</p>
        </div>

        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Profit/Loss</h3>
                <span class="text-2xl font-bold text-crypto-green">+$1,245.32</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">+8.2% all time</p>
        </div>

        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Active Investments</h3>
                <span class="text-2xl font-bold text-crypto-blue">4</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">2 staking, 2 auto-invest</p>
        </div>
    </div>

    <!-- Asset Allocation -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg mb-8">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Asset Allocation</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
                <canvas id="allocationChart" height="250"></canvas>
            </div>
            <div class="space-y-4">
                <% ['Bitcoin', 'Ethereum', 'Cardano', 'Polkadot', 'Other'].forEach((asset, index) => { %>
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full 
                            <%= index === 0 ? 'bg-yellow-500' : 
                               index === 1 ? 'bg-gray-400' : 
                               index === 2 ? 'bg-green-500' : 
                               index === 3 ? 'bg-purple-500' : 'bg-gray-600' %> mr-2">
                        </div>
                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= asset %></span>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">
                        <%= index === 0 ? '40%' : 
                           index === 1 ? '25%' : 
                           index === 2 ? '15%' : 
                           index === 3 ? '12%' : '8%' %>
                    </span>
                </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Assets List -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg mb-8">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Your Assets</h3>
        
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead>
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Asset</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Balance</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Value</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Price</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">24h Change</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% wallets.forEach(wallet => { %>
                    <tr>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <div class="flex items-center">
                                <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center mr-3">
                                    <span class="text-xs font-bold"><%= wallet.currency.substring(0, 2) %></span>
                                </div>
                                <div>
                                    <div class="text-sm font-medium text-gray-900 dark:text-white"><%= wallet.currency %></div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">Crypto</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-white">
                            <%= wallet.balance.toFixed(8) %>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-white">
                            $<%=(wallet.balance * (wallet.currentPrice || 1)).toFixed(2)%>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-white">
                            $<%=(wallet.currentPrice || 0).toFixed(2)%>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-green-600">
                            +2.5%
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm font-medium">
                            <div class="flex space-x-2">
                                <a href="/client/deposit" class="text-crypto-blue hover:text-blue-600">Deposit</a>
                                <a href="/client/withdraw" class="text-crypto-blue hover:text-blue-600">Withdraw</a>
                                <a href="#" class="text-crypto-blue hover:text-blue-600">Trade</a>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Investment Plans -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Investment Plans</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-gray-100 dark:bg-gray-800 p-6 rounded-lg">
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Basic Plan</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Start your investment journey</p>
                <div class="mb-4">
                    <span class="text-2xl font-bold text-crypto-green">8%</span>
                    <span class="text-sm text-gray-600 dark:text-gray-400">APY</span>
                </div>
                <ul class="text-sm text-gray-600 dark:text-gray-400 mb-6 space-y-2">
                    <li>Minimum: $100</li>
                    <li>30 days duration</li>
                    <li>Daily rewards</li>
                </ul>
                <button class="w-full bg-crypto-blue text-white py-2 rounded-lg hover:bg-blue-600 transition-colors">
                    Invest Now
                </button>
            </div>

            <div class="bg-gray-100 dark:bg-gray-800 p-6 rounded-lg border-2 border-crypto-blue">
                <div class="bg-crypto-blue text-white text-xs font-bold px-3 py-1 rounded-full inline-block mb-3">POPULAR</div>
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Pro Plan</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">For serious investors</p>
                <div class="mb-4">
                    <span class="text-2xl font-bold text-crypto-green">12%</span>
                    <span class="text-sm text-gray-600 dark:text-gray-400">APY</span>
                </div>
                <ul class="text-sm text-gray-600 dark:text-gray-400 mb-6 space-y-2">
                    <li>Minimum: $1,000</li>
                    <li>60 days duration</li>
                    <li>Daily rewards + bonus</li>
                </ul>
                <button class="w-full bg-crypto-blue text-white py-2 rounded-lg hover:bg-blue-600 transition-colors">
                    Invest Now
                </button>
            </div>

            <div class="bg-gray-100 dark:bg-gray-800 p-6 rounded-lg">
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">VIP Plan</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Maximum returns</p>
                <div class="mb-4">
                    <span class="text-2xl font-bold text-crypto-green">18%</span>
                    <span class="text-sm text-gray-600 dark:text-gray-400">APY</span>
                </div>
                <ul class="text-sm text-gray-600 dark:text-gray-400 mb-6 space-y-2">
                    <li>Minimum: $5,000</li>
                    <li>90 days duration</li>
                    <li>Daily rewards + VIP support</li>
                </ul>
                <button class="w-full bg-crypto-blue text-white py-2 rounded-lg hover:bg-blue-600 transition-colors">
                    Invest Now
                </button>
            </div>
        </div>
    </div>
</main>

<script>
    // Asset Allocation Chart
    const allocationCtx = document.getElementById('allocationChart').getContext('2d');
    new Chart(allocationCtx, {
        type: 'doughnut',
        data: {
            labels: ['Bitcoin', 'Ethereum', 'Cardano', 'Polkadot', 'Other'],
            datasets: [{
                data: [40, 25, 15, 12, 8],
                backgroundColor: [
                    '#f59e0b',
                    '#4f46e5',
                    '#10b981',
                    '#8b5cf6',
                    '#6b7280'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });
</script>

<%- include('../partials/footer') %>