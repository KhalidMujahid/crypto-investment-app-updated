<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Portfolio</h2>
      <p class="page-sub">Allocation and performance across your holdings.</p>
    </div>
    <a href="/client/deposit" class="btn btn-primary">Add funds</a>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="card card-body">
      <p class="text-sm font-medium muted">Total balance</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">$12,458.32</p>
      <p class="mt-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">+2.5% today</p>
    </div>
    <div class="card card-body">
      <p class="text-sm font-medium muted">Profit / loss</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">+$1,245.32</p>
      <p class="mt-1 text-xs muted">+8.2% all time</p>
    </div>
    <div class="card card-body">
      <p class="text-sm font-medium muted">Active investments</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">4</p>
      <p class="mt-1 text-xs muted">2 staking · 2 auto-invest</p>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Asset allocation</h3></div>
      <div class="card-body"><canvas id="allocationChart" height="240"></canvas></div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Breakdown</h3></div>
      <div class="card-body space-y-4">
        <% ['Bitcoin', 'Ethereum', 'Cardano', 'Polkadot', 'Other'].forEach(function (asset, index) { %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full <%= index === 0 ? 'bg-amber-500' : index === 1 ? 'bg-indigo-500' : index === 2 ? 'bg-emerald-500' : index === 3 ? 'bg-violet-500' : 'bg-slate-400' %>"></span>
              <span class="text-sm text-slate-700 dark:text-slate-300"><%= asset %></span>
            </div>
            <span class="text-sm font-medium muted"><%= index === 0 ? '40%' : index === 1 ? '25%' : index === 2 ? '15%' : index === 3 ? '12%' : '8%' %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="card mt-6">
    <div class="card-header"><h3 class="card-title">Your assets</h3></div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Asset</th><th>Balance</th><th>Value</th><th>Price</th><th>24h</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (!wallets || wallets.length === 0) { %>
            <tr><td colspan="6" class="text-center muted">No assets yet.</td></tr>
          <% } %>
          <% (wallets || []).forEach(function (wallet) { %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= wallet.currency.substring(0, 2) %></span>
                  <div>
                    <p class="font-medium text-slate-900 dark:text-white"><%= wallet.currency %></p>
                    <p class="text-xs muted">Crypto</p>
                  </div>
                </div>
              </td>
              <td><%= wallet.balance.toFixed(8) %></td>
              <td>$<%= (wallet.balance * (wallet.currentPrice || 1)).toFixed(2) %></td>
              <td>$<%= (wallet.currentPrice || 0).toFixed(2) %></td>
              <td class="text-emerald-600 dark:text-emerald-400">+2.5%</td>
              <td>
                <div class="flex gap-3 text-sm font-medium">
                  <a href="/client/deposit" class="text-brand-600 hover:text-brand-700 dark:text-brand-400">Deposit</a>
                  <a href="/client/withdraw" class="text-brand-600 hover:text-brand-700 dark:text-brand-400">Withdraw</a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
    <% [
      { name: 'Basic', apy: '8%', min: '$100', duration: '30 days', popular: false },
      { name: 'Pro', apy: '12%', min: '$1,000', duration: '60 days', popular: true },
      { name: 'VIP', apy: '18%', min: '$5,000', duration: '90 days', popular: false }
    ].forEach(function (plan) { %>
      <div class="card card-body <%= plan.popular ? 'ring-2 ring-brand-500' : '' %>">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold text-slate-900 dark:text-white"><%= plan.name %> plan</h3>
          <% if (plan.popular) { %><span class="badge badge-brand">Popular</span><% } %>
        </div>
        <p class="mt-4 text-3xl font-bold text-slate-900 dark:text-white"><%= plan.apy %> <span class="text-base font-medium muted">APY</span></p>
        <ul class="mt-4 space-y-2 text-sm muted">
          <li>Minimum: <%= plan.min %></li>
          <li>Duration: <%= plan.duration %></li>
          <li>Daily rewards</li>
        </ul>
        <button class="btn btn-primary mt-6 w-full">Invest now</button>
      </div>
    <% }); %>
  </div>
</main>

<script>
  (function () {
    var el = document.getElementById('allocationChart');
    if (!el) return;
    new Chart(el.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Bitcoin', 'Ethereum', 'Cardano', 'Polkadot', 'Other'],
        datasets: [{
          data: [40, 25, 15, 12, 8],
          backgroundColor: ['#d97706', '#4f46e5', '#059669', '#7c3aed', '#94a3b8'],
          borderWidth: 0,
        }],
      },
      options: {
        responsive: true,
        cutout: '68%',
        plugins: { legend: { display: false } },
      },
    });
  })();
</script>

<%- include('../partials/footer') %>
