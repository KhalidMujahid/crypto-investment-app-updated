<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Withdraw Funds</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Withdrawal Form -->
        <div class="lg:col-span-2">
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Withdraw Cryptocurrency</h2>
                
                <form action="/client/withdraw" method="POST">
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Currency</label>
                        <select name="currency" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" required>
                            <option value="">Select a currency</option>
                            <% wallets.forEach(wallet => { %>
                                <% if (wallet.balance > 0) { %>
                                    <option value="<%= wallet.currency %>"><%= wallet.currency %> (Balance: <%= wallet.balance.toFixed(8) %>)</option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Withdrawal Address</label>
                        <input type="text" name="address" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" placeholder="Enter your external wallet address" required>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Amount</label>
                        <div class="relative">
                            <input type="number" name="amount" step="0.00000001" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" placeholder="0.00" required>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                <span class="text-gray-500 dark:text-gray-400">BTC</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Network Fee</label>
                        <p class="text-sm text-gray-600 dark:text-gray-400">0.0005 BTC (Estimated)</p>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">You Will Receive</label>
                        <p class="text-lg font-semibold text-gray-900 dark:text-white">0.00 BTC</p>
                    </div>

                    <div class="flex items-center mb-6">
                        <input id="terms" name="terms" type="checkbox" class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded" required>
                        <label for="terms" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
                            I confirm that this withdrawal address is correct and I accept the network fee
                        </label>
                    </div>

                    <button type="submit" class="w-full bg-crypto-blue text-white py-3 rounded-lg hover:bg-blue-600 transition-colors">
                        Process Withdrawal
                    </button>
                </form>
            </div>
        </div>

        <!-- Withdrawal Information -->
        <div class="space-y-6">
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Withdrawal Limits</h2>
                
                <div class="space-y-4">
                    <div>
                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Daily Limit</p>
                        <p class="text-lg font-semibold text-gray-900 dark:text-white">10 BTC</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Used Today</p>
                        <p class="text-lg font-semibold text-gray-900 dark:text-white">0.5 BTC</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Remaining Today</p>
                        <p class="text-lg font-semibold text-crypto-green">9.5 BTC</p>
                    </div>
                </div>
            </div>

            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Recent Withdrawals</h2>
                
                <div class="space-y-4">
                    <% for(let i = 0; i < 3; i++) { %>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">BTC Withdrawal</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Yesterday</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-medium text-gray-900 dark:text-white">0.1 BTC</p>
                            <p class="text-xs text-green-600">Completed</p>
                        </div>
                    </div>
                    <% } %>
                </div>

                <a href="/client/transactions" class="block mt-4 text-center text-crypto-blue hover:text-blue-600">
                    View all transactions
                </a>
            </div>

            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Security Notice</h2>
                
                <ul class="list-disc list-inside space-y-2 text-sm text-gray-700 dark:text-gray-300">
                    <li>Withdrawals require email confirmation</li>
                    <li>Processing time: 1-24 hours for security review</li>
                    <li>Always double-check withdrawal addresses</li>
                    <li>We are not responsible for funds sent to wrong addresses</li>
                    <li>Contact support if you encounter any issues</li>
                </ul>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const amountInput = document.querySelector('input[name="amount"]');
        const receivedElement = document.querySelector('p.text-lg.font-semibold');
        
        amountInput.addEventListener('input', function() {
            const amount = parseFloat(this.value) || 0;
            const fee = 0.0005;
            const received = amount - fee;
            
            receivedElement.textContent = received > 0 ? received.toFixed(8) + ' BTC' : '0.00 BTC';
        });
    });
</script>

<%- include('../partials/footer') %>