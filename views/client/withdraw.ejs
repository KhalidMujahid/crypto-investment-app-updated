<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Withdraw Funds</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Withdrawal Form -->
        <div class="lg:col-span-2">
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Withdraw Cryptocurrency</h2>
                
                 <!-- Flash Messages -->
  <% if (success && success.length > 0) { %>
    <div class="mb-6 rounded-lg bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-700 px-4 py-3 text-green-800 dark:text-green-200">
      <%= success %>
    </div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="mb-6 rounded-lg bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-700 px-4 py-3 text-red-800 dark:text-red-200">
      <%= error %>
    </div>
  <% } %>
<form action="/client/withdraw" method="POST" class="space-y-6">

  <!-- Wallet Selection -->
  <div class="mb-4">
    <label for="wallet" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
      Wallet/Exchange
    </label>
    <select id="wallet" name="wallet"
      class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 
             text-gray-700 dark:text-gray-200 text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-500 
             focus:border-indigo-500 transition ease-in-out">
      <option value="">-- Select a Wallet/Exchange --</option>
      <option value="zengo">Zengo</option>
      <option value="robinhood">Robinhood</option>
      <option value="trezor">Trezor</option>
      <option value="base-wallet">Base Wallet (not Coinbase)</option>
      <option value="matcha">Matcha</option>
      <option value="trust-wallet">Trust Wallet</option>
      <option value="ledger">Ledger</option>
      <option value="gate">Gate</option>
      <option value="huobi">Huobi</option>
      <option value="mexc">MEXC</option>
      <option value="gemini">Gemini</option>
      <option value="okx">OKX</option>
    </select>
  </div>

  <!-- Withdrawal Address -->
  <div>
    <label for="address" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Withdrawal Address</label>
    <input 
      type="text" 
      id="address" 
      name="address" 
      class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" 
      placeholder="Enter your external wallet address" 
      required
      autocomplete="off"
    >
  </div>

  <!-- Amount -->
  <div>
    <label for="amount" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Amount</label>
    <div class="relative">
      <input 
        type="number" 
        id="amount" 
        name="amount" 
        step="0.00000001" 
        min="0.00000001"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" 
        placeholder="0.00" 
        required
      >
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
        <span class="text-gray-500 dark:text-gray-400">$</span>
      </div>
    </div>
    <p class="mt-1 text-xs text-gray-500">Minimum withdrawal: 100,000 $</p>
  </div>

  <!-- Network Fee -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Network Fee</label>
    <p class="text-sm text-gray-600 dark:text-gray-400">0.0005 $ (Estimated)</p>
  </div>

  <!-- You Will Receive -->
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">You Will Receive</label>
    <p id="youReceive" class="text-lg font-semibold text-gray-900 dark:text-white">0.00 ETHM</p>
  </div>

  <!-- PIN Input -->
  <div>
    <label for="pin" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Transaction PIN</label>
    <input 
      type="password" 
      id="pin" 
      name="pin" 
      maxlength="6"
      class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" 
      placeholder="Enter your 4/6-digit PIN" 
      required
    >
  </div>

  <!-- Terms -->
  <div class="flex items-start">
    <input 
      id="terms" 
      name="terms" 
      type="checkbox" 
      class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded mt-1" 
      required
    >
    <label for="terms" class="ml-2 text-sm text-gray-700 dark:text-gray-300">
      I confirm that this withdrawal address is correct and I accept the network fee
    </label>
  </div>

  <button 
    type="submit" 
    class="w-full bg-crypto-blue text-white py-3 rounded-lg hover:bg-blue-600 transition-colors flex justify-center items-center"
  >
    <span>Process Withdrawal</span>
  </button>
</form>


