<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Withdraw Funds</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Withdrawal Form -->
        <div class="lg:col-span-2">
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Withdraw Cryptocurrency</h2>
                
                <form action="/client/withdraw" method="POST" class="space-y-6">
  <!-- Flash Messages -->
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger flex justify-between items-center bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
      <span><%= error.join('<br>') %></span>
      <button type="button" class="ml-2 text-red-700 hover:text-red-900" onclick="this.parentElement.remove()">
        &times;
      </button>
    </div>
  <% } %>

  <% if (success && success.length > 0) { %>
    <div class="alert alert-success flex justify-between items-center bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
      <span><%= success.join('<br>') %></span>
      <button type="button" class="ml-2 text-green-700 hover:text-green-900" onclick="this.parentElement.remove()">
        &times;
      </button>
    </div>
  <% } %>

  <div>
    <label for="address" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Withdrawal Address</label>
    <input 
      type="text" 
      id="address" 
      name="address" 
      class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" 
      placeholder="Enter your external wallet address" 
      required
      autocomplete="off"
    >
  </div>

  <div>
    <label for="amount" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Amount</label>
    <div class="relative">
      <input 
        type="number" 
        id="amount" 
        name="amount" 
        step="0.00000001" 
        min="0.00000001"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" 
        placeholder="0.00" 
        required
      >
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
        <span class="text-gray-500 dark:text-gray-400">$</span>
      </div>
    </div>
    <p class="mt-1 text-xs text-gray-500">Minimum withdrawal: 0.0005 $</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Network Fee</label>
    <p class="text-sm text-gray-600 dark:text-gray-400">0.0005 $ (Estimated)</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">You Will Receive</label>
    <p id="youReceive" class="text-lg font-semibold text-gray-900 dark:text-white">0.00 ETHM</p>
  </div>

  <div class="flex items-start">
    <input 
      id="terms" 
      name="terms" 
      type="checkbox" 
      class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded mt-1" 
      required
    >
    <label for="terms" class="ml-2 text-sm text-gray-700 dark:text-gray-300">
      I confirm that this withdrawal address is correct and I accept the network fee
    </label>
  </div>

  <button 
    type="submit" 
    class="w-full bg-crypto-blue text-white py-3 rounded-lg hover:bg-blue-600 transition-colors flex justify-center items-center"
  >
    <span>Process Withdrawal</span>
  </button>
</form>

