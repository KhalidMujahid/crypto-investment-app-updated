<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Withdraw funds</h2>
      <p class="page-sub">Send funds to an external wallet or exchange. Requests are reviewed before processing.</p>
    </div>
  </div>

  <% if (error && error.length > 0) { %>
    <div class="mb-6 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300">
      <%= error %>
    </div>
  <% } %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Form -->
    <div class="card lg:col-span-2">
      <div class="card-header">
        <h3 class="card-title">Withdrawal details</h3>
      </div>
      <div class="card-body">
        <form action="/client/withdraw" method="POST" class="space-y-5">

          <div>
            <label for="wallet" class="label">Destination wallet / exchange</label>
            <select id="wallet" name="wallet" class="input" required>
              <option value="">Select a destination</option>
              <option value="zengo">Zengo</option>
              <option value="robinhood">Robinhood</option>
              <option value="trezor">Trezor</option>
              <option value="base-wallet">Base Wallet (not Coinbase)</option>
              <option value="matcha">Matcha</option>
              <option value="trust-wallet">Trust Wallet</option>
              <option value="ledger">Ledger</option>
              <option value="gate">Gate</option>
              <option value="huobi">Huobi</option>
              <option value="mexc">MEXC</option>
              <option value="gemini">Gemini</option>
              <option value="okx">OKX</option>
            </select>
          </div>

          <div>
            <label for="address" class="label">Withdrawal address</label>
            <input type="text" id="address" name="address" class="input font-mono" placeholder="Enter your external wallet address" required autocomplete="off" />
          </div>

          <div>
            <label for="amount" class="label">Amount (USD)</label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm text-slate-400">$</span>
              <input type="number" id="amount" name="amount" step="0.00000001" min="0.00000001" class="input pl-7" placeholder="0.00" required />
            </div>
            <p class="hint">Minimum withdrawal: 100,000 $</p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/50">
            <div class="flex items-center justify-between text-sm">
              <span class="muted">Network fee (estimated)</span>
              <span class="font-medium text-slate-700 dark:text-slate-200">0.0005 ETHM</span>
            </div>
            <div class="mt-2 flex items-center justify-between text-sm">
              <span class="muted">You will receive</span>
              <span id="youReceive" class="font-semibold text-slate-900 dark:text-white">0.00 ETHM</span>
            </div>
          </div>

          <div>
            <label for="pin" class="label">Transaction PIN</label>
            <input type="password" id="pin" name="pin" maxlength="6" inputmode="numeric" class="input tracking-[0.4em]" placeholder="••••" required />
          </div>

          <label class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300">
            <input id="terms" name="terms" type="checkbox" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500/40 dark:border-slate-600 dark:bg-slate-900">
            I confirm this withdrawal address is correct and accept the network fee.
          </label>

          <button type="submit" class="btn btn-primary w-full">Process withdrawal</button>
        </form>
      </div>
    </div>

    <!-- Info -->
    <div class="space-y-6">
      <div class="card card-body">
        <h3 class="card-title">Before you withdraw</h3>
        <ul class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
          <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Withdrawals require a verified account.</li>
          <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Only one request is allowed every 7 days.</li>
          <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Double-check the address — transfers can't be reversed.</li>
          <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Processing usually completes within 1–24 hours.</li>
        </ul>
      </div>

      <div class="card card-body">
        <h3 class="card-title">Need help?</h3>
        <p class="mt-2 text-sm muted">If a withdrawal is stuck or you spot something unusual, contact support before retrying.</p>
        <a href="/client/transactions" class="mt-4 inline-block text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">View transaction history</a>
      </div>
    </div>
  </div>
</main>

<% if (success && success.length > 0) { %>
<div x-data="{ show: true }" x-show="show" x-transition x-init="setTimeout(() => show = false, 4000)" class="fixed right-4 top-4 z-50">
  <div class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-white px-4 py-3 shadow-soft dark:border-emerald-500/30 dark:bg-slate-900">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    <span class="text-sm font-medium text-slate-700 dark:text-slate-200"><%= success %></span>
    <button type="button" @click="show = false" class="ml-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
</div>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var amountInput = document.querySelector('input[name="amount"]');
    var receivedElement = document.querySelector('#youReceive');
    var MIN_WITHDRAWAL = 100000;
    var ethmPrice = 0;
    var alertShown = false;

    async function fetchPrice() {
      try {
        var res = await fetch('https://api.coingecko.com/api/v3/coins/ethereum-meta');
        var data = await res.json();
        ethmPrice = data.market_data.current_price.usd;
        calculate();
      } catch (error) {
        console.error('Failed to fetch ETHM price:', error);
        ethmPrice = 0;
      }
    }

    function calculate() {
      var amountUSDT = parseFloat(amountInput.value) || 0;
      var fee = 0.0005;

      if (amountUSDT > 0 && amountUSDT < MIN_WITHDRAWAL) {
        if (!alertShown) {
          alertShown = true;
          alert('Minimum withdrawal amount is ' + MIN_WITHDRAWAL.toLocaleString() + ' $');
        }
        receivedElement.textContent = '0.00 ETHM';
        return;
      }
      alertShown = false;

      if (ethmPrice > 0 && amountUSDT >= MIN_WITHDRAWAL) {
        var ethmAmount = (amountUSDT / ethmPrice) - fee;
        receivedElement.textContent = ethmAmount > 0 ? ethmAmount.toFixed(8) + ' ETHM' : '0.00 ETHM';
      } else if (ethmPrice === 0) {
        receivedElement.textContent = 'Fetching price…';
      } else {
        receivedElement.textContent = '0.00 ETHM';
      }
    }

    fetchPrice();
    amountInput.addEventListener('input', calculate);
    setInterval(fetchPrice, 60000);
  });
</script>

<%- include('../partials/footer') %>
