<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Deposit funds</h2>
      <p class="page-sub">Send crypto to your deposit address below.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <div class="card lg:col-span-2">
      <div class="card-header"><h3 class="card-title">Deposit cryptocurrency</h3></div>
      <div class="card-body">
        <div class="max-w-md">
          <label class="label">Asset</label>
          <select class="input">
            <option>Bitcoin (BTC)</option>
            <option>Ethereum (ETH)</option>
            <option>USDT (ERC20)</option>
            <option>USDT (TRC20)</option>
            <option>Cardano (ADA)</option>
            <option>Polkadot (DOT)</option>
          </select>
        </div>

        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
          Send only the selected asset to this address. Sending anything else may result in permanent loss.
        </div>

        <div class="mt-6 flex flex-col items-center gap-5 sm:flex-row sm:items-start">
          <div id="qrcode" class="inline-flex rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700"></div>

          <div class="w-full flex-1">
            <label class="label">Deposit address</label>
            <div class="flex">
              <input type="text" id="depositAddress" readonly value="<%= depositAddress || '1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa' %>"
                     class="input rounded-r-none font-mono text-xs">
              <button type="button" onclick="copyAddress()" class="btn btn-primary rounded-l-none">Copy</button>
            </div>
            <p class="hint">Network confirmations required: 3.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="card card-body">
        <h3 class="card-title">How it works</h3>
        <ol class="mt-4 space-y-3 text-sm text-slate-600 dark:text-slate-300">
          <li class="flex gap-3"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">1</span>Copy the address or scan the QR code.</li>
          <li class="flex gap-3"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">2</span>Send funds from your external wallet.</li>
          <li class="flex gap-3"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">3</span>Wait for network confirmations.</li>
          <li class="flex gap-3"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">4</span>Funds are credited automatically.</li>
        </ol>
      </div>

      <div class="card card-body">
        <h3 class="card-title">Recent deposits</h3>
        <div class="mt-4 space-y-4">
          <% for (let i = 0; i < 3; i++) { %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white">BTC deposit</p>
                <p class="text-xs muted">2 hours ago</p>
              </div>
              <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">Completed</p>
            </div>
          <% } %>
        </div>
        <a href="/client/transactions" class="mt-4 inline-block text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">View all transactions</a>
      </div>
    </div>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var address = document.getElementById('depositAddress').value;
    if (window.QRCode && address) {
      new QRCode(document.getElementById('qrcode'), { text: address, width: 148, height: 148 });
    }
  });

  function copyAddress() {
    var address = document.getElementById('depositAddress').value;
    navigator.clipboard.writeText(address).then(function () {
      var btn = event && event.target ? event.target : null;
      if (btn) {
        var original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = original; }, 1500);
      }
    });
  }
</script>

<%- include('../partials/footer') %>
