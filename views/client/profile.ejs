<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Profile settings</h2>
      <p class="page-sub">Manage your personal details, security and verification.</p>
    </div>
  </div>

  <% if (success && success.length > 0) { %>
    <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300"><%= success %></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="mb-6 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300"><%= error %></div>
  <% } %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Left column -->
    <div class="space-y-6 lg:col-span-2">

      <!-- Personal information -->
      <div class="card">
        <div class="card-header"><h3 class="card-title">Personal information</h3></div>
        <div class="card-body">
          <form action="/client/profile" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label class="label">First name</label>
                <input type="text" name="firstName" value="<%= user.firstName %>" class="input" required>
              </div>
              <div>
                <label class="label">Last name</label>
                <input type="text" name="lastName" value="<%= user.lastName %>" class="input" required>
              </div>
            </div>

            <div>
              <label class="label">Email address</label>
              <input type="email" name="email" value="<%= user.email %>" class="input" required>
            </div>

            <div>
              <label class="label">Theme preference</label>
              <select name="theme" class="input">
                <option value="light" <%= user.preferences.theme === 'light' ? 'selected' : '' %>>Light</option>
                <option value="dark" <%= user.preferences.theme === 'dark' ? 'selected' : '' %>>Dark</option>
              </select>
            </div>

            <div>
              <span class="label">Notifications</span>
              <div class="mt-1 space-y-3">
                <label class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                  <input type="checkbox" name="notifications" value="email" <%= user.preferences.notifications.email ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500/40 dark:border-slate-600 dark:bg-slate-900">
                  Email notifications
                </label>
                <label class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                  <input type="checkbox" name="notifications" value="push" <%= user.preferences.notifications.push ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500/40 dark:border-slate-600 dark:bg-slate-900">
                  Push notifications
                </label>
                <label class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                  <input type="checkbox" name="notifications" value="priceAlerts" <%= user.preferences.notifications.priceAlerts ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500/40 dark:border-slate-600 dark:bg-slate-900">
                  Price alerts
                </label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
          </form>
        </div>
      </div>

      <!-- Security -->
      <div class="card">
        <div class="card-header"><h3 class="card-title">Security</h3></div>
        <div class="card-body divide-y divide-slate-100 dark:divide-slate-800">
          <div class="flex items-center justify-between gap-4 pb-4">
            <div>
              <p class="text-sm font-medium text-slate-900 dark:text-white">Withdrawal PIN</p>
              <p class="text-sm muted">Secure withdrawals with a 4–6 digit PIN.</p>
            </div>
            <button type="button" data-modal-target="setPinModal" class="btn btn-secondary btn-sm">
              <%= user.pin ? 'Change PIN' : 'Set PIN' %>
            </button>
          </div>

          <div class="flex items-center justify-between gap-4 pt-4">
            <div>
              <p class="text-sm font-medium text-slate-900 dark:text-white">Two-factor authentication</p>
              <p class="text-sm muted"><%= user.twoFactorEnabled ? 'Currently enabled.' : 'Currently disabled.' %></p>
            </div>
            <form action="/client/toggle-2fa" method="POST">
              <button type="submit" class="btn <%= user.twoFactorEnabled ? 'btn-secondary' : 'btn-primary' %> btn-sm">
                <%= user.twoFactorEnabled ? 'Disable' : 'Enable' %>
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- KYC -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Identity verification (KYC)</h3>
          <span class="badge <%= user.kycStatus === 'verified' ? 'badge-success' : user.kycStatus === 'pending' ? 'badge-warning' : user.kycStatus === 'rejected' ? 'badge-danger' : 'badge-neutral' %>">
            <%= user.kycStatus.replace('_', ' ') %>
          </span>
        </div>
        <div class="card-body">
          <p class="text-sm muted">
            Verify your identity to unlock withdrawals and full platform access. An admin reviews each request.
          </p>

          <% if (user.kycStatus === 'verified') { %>
            <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300">
              Your identity has been verified. You have full access to the platform.
            </div>
          <% } else if (user.kycStatus === 'pending') { %>
            <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
              Your request is pending admin approval. We'll notify you once it's reviewed.
            </div>
          <% } else { %>
            <% if (user.kycStatus === 'rejected') { %>
              <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300">
                Your previous request was rejected.<% if (user.kycNotes) { %> <strong>Reason:</strong> <%= user.kycNotes %><% } %>
              </div>
            <% } %>
            <form action="/client/kyc/submit" method="POST" class="mt-4">
              <button type="submit" class="btn btn-primary">
                <%= user.kycStatus === 'rejected' ? 'Resubmit for verification' : 'Submit for verification' %>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Right column -->
    <div class="space-y-6">
      <div class="card card-body">
        <div class="flex items-center gap-4">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white">
            <%= user.firstName.charAt(0) %><%= user.lastName.charAt(0) %>
          </span>
          <div class="min-w-0">
            <p class="truncate text-base font-semibold text-slate-900 dark:text-white"><%= user.firstName %> <%= user.lastName %></p>
            <p class="truncate text-sm muted"><%= user.email %></p>
          </div>
        </div>
        <dl class="mt-5 space-y-3 border-t border-slate-100 pt-4 text-sm dark:border-slate-800">
          <div class="flex justify-between"><dt class="muted">Referral code</dt><dd class="font-mono font-medium text-slate-800 dark:text-slate-200"><%= user.referralCode || '—' %></dd></div>
          <div class="flex justify-between"><dt class="muted">Account status</dt><dd><span class="badge <%= user.status === 'active' ? 'badge-success' : 'badge-danger' %>"><%= user.status %></span></dd></div>
          <div class="flex justify-between"><dt class="muted">2FA</dt><dd class="font-medium text-slate-800 dark:text-slate-200"><%= user.twoFactorEnabled ? 'Enabled' : 'Disabled' %></dd></div>
        </dl>
      </div>

      <div class="card card-body">
        <h3 class="card-title">Recent sign-in</h3>
        <% const lastLogin = user.security && user.security.lastLogin; %>
        <p class="mt-2 text-sm muted">
          <%= lastLogin ? new Date(lastLogin).toLocaleString() : 'No sign-in recorded yet.' %>
        </p>
      </div>
    </div>
  </div>
</main>

<!-- Set PIN modal -->
<div id="setPinModal" class="modal-overlay fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-sm" role="presentation" aria-hidden="true">
  <div role="dialog" aria-modal="true" aria-labelledby="setPinLabel" class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-start justify-between">
      <div>
        <h3 id="setPinLabel" class="text-lg font-semibold text-slate-900 dark:text-white">Set withdrawal PIN</h3>
        <p class="mt-1 text-sm muted">Choose a 4–6 digit PIN you'll use to confirm withdrawals.</p>
      </div>
      <button type="button" data-modal-hide="setPinModal" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200">
        <span class="sr-only">Close</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form action="/client/set-pin" method="POST" class="mt-5 space-y-4">
      <div>
        <label class="label">New PIN</label>
        <input type="password" name="pin" minlength="4" maxlength="6" required inputmode="numeric" pattern="\d{4,6}" placeholder="••••" class="input tracking-[0.4em]">
      </div>
      <div>
        <label class="label">Confirm PIN</label>
        <input type="password" name="confirmPin" minlength="4" maxlength="6" required inputmode="numeric" pattern="\d{4,6}" placeholder="••••" class="input tracking-[0.4em]">
      </div>
      <div class="flex justify-end gap-3 pt-1">
        <button type="button" data-modal-hide="setPinModal" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">Save PIN</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    function showModal(modal) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      var first = modal.querySelector('input, button, [tabindex]');
      if (first) first.focus();
    }

    function hideModal(modal) {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      var openBtn = e.target.closest('[data-modal-target]');
      if (openBtn) {
        e.preventDefault();
        showModal(document.getElementById(openBtn.getAttribute('data-modal-target')));
        return;
      }

      var hideBtn = e.target.closest('[data-modal-hide]');
      if (hideBtn) {
        e.preventDefault();
        hideModal(document.getElementById(hideBtn.getAttribute('data-modal-hide')));
        return;
      }

      var overlay = e.target.closest('.modal-overlay');
      if (overlay && e.target === overlay) hideModal(overlay);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(hideModal);
      }
    });
  })();
</script>

<%- include('../partials/footer') %>
