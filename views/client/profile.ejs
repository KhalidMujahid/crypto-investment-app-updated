<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Profile Settings</h1>
     <% if (success && success.length > 0) { %>
    <div class="mb-6 rounded-lg bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-700 px-4 py-3 text-green-800 dark:text-green-200">
      <%= success %>
    </div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="mb-6 rounded-lg bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-700 px-4 py-3 text-red-800 dark:text-red-200">
      <%= error %>
    </div>
  <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Profile Form -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Personal Information -->
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Personal Information</h2>
                
                <form action="/client/profile" method="POST">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">First Name</label>
                            <input type="text" name="firstName" value="<%= user.firstName %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Last Name</label>
                            <input type="text" name="lastName" value="<%= user.lastName %>" 
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                        <input type="email" name="email" value="<%= user.email %>" 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" required>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Theme Preference</label>
                        <select name="theme" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                            <option value="dark" <%= user.preferences.theme === 'dark' ? 'selected' : '' %>>Dark</option>
                            <option value="light" <%= user.preferences.theme === 'light' ? 'selected' : '' %>>Light</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Notifications</label>
                        <div class="space-y-2">
                            <div class="flex items-center">
                                <input type="checkbox" id="emailNotif" name="notifications" value="email" 
                                       <%= user.preferences.notifications.email ? 'checked' : '' %> 
                                       class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded">
                                <label for="emailNotif" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">Email Notifications</label>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" id="pushNotif" name="notifications" value="push" 
                                       <%= user.preferences.notifications.push ? 'checked' : '' %>
                                       class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded">
                                <label for="pushNotif" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">Push Notifications</label>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" id="priceNotif" name="notifications" value="priceAlerts" 
                                       <%= user.preferences.notifications.priceAlerts ? 'checked' : '' %>
                                       class="h-4 w-4 text-crypto-blue focus:ring-blue-500 border-gray-300 rounded">
                                <label for="priceNotif" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">Price Alerts</label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="bg-crypto-blue text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                        Save Changes
                    </button>
                </form>
            </div>
<!-- Security Settings -->
<div class="glassmorphism rounded-2xl p-6 shadow-lg">
  <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Security Settings</h2>

  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="font-medium text-gray-900 dark:text-white">Withdrawal PIN</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Secure your withdrawals with a 4-digit PIN
        </p>
      </div>

      <button
        type="button"
        data-modal-target="setPinModal"
        data-modal-toggle="setPinModal"
        class="text-crypto-blue hover:text-blue-600 text-sm font-medium"
      >
        <%= user.pin ? 'Change PIN' : 'Set PIN' %>
      </button>
    </div>

    <!-- ... other security rows ... -->
  </div>
</div>

<!-- Modal overlay (hidden by default) -->
<div
  id="setPinModal"
  class="hidden modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
  role="presentation"
  aria-hidden="true"
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="setPinLabel"
    class="bg-white dark:bg-gray-800 rounded-xl p-6 w-full max-w-md mx-4"
  >
    <div class="flex justify-end">
      <button type="button" data-modal-hide="setPinModal" aria-label="Close" class="text-gray-500 hover:text-gray-700">
        ✕
      </button>
    </div>

    <h3 id="setPinLabel" class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Set Withdrawal PIN</h3>

    <form action="/client/set-pin" method="POST" class="space-y-4">
      <input
        type="password"
        name="pin"
        minlength="4"
        maxlength="6"
        required
        inputmode="numeric"
        pattern="\d{4,6}"
        placeholder="Enter 4-6 digit PIN"
        class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
      />

      <input
        type="password"
        name="confirmPin"
        minlength="4"
        maxlength="6"
        required
        inputmode="numeric"
        pattern="\d{4,6}"
        placeholder="Confirm PIN"
        class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
      />

      <div class="flex justify-end gap-3">
        <button
          type="button"
          data-modal-hide="setPinModal"
          class="px-4 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300"
        >
          Cancel
        </button>

        <button type="submit" class="px-4 py-2 text-sm rounded-lg bg-crypto-blue text-white hover:bg-blue-600">
          Save PIN
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    function showModal(modal) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden'; 
      const first = modal.querySelector('input, button, [tabindex]');
      if (first) first.focus();
    }

    function hideModal(modal) {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      const openBtn = e.target.closest('[data-modal-toggle], [data-modal-target]');
      if (openBtn) {
        e.preventDefault();
        const targetId = openBtn.getAttribute('data-modal-target') || openBtn.getAttribute('data-modal-toggle');
        const modal = document.getElementById(targetId);
        if (!modal) {
          console.warn('Modal target not found:', targetId);
          return;
        }
        showModal(modal);
        return;
      }

      const hideBtn = e.target.closest('[data-modal-hide]');
      if (hideBtn) {
        e.preventDefault();
        const targetId = hideBtn.getAttribute('data-modal-hide');
        let modal = null;
        if (targetId) modal = document.getElementById(targetId);
        if (!modal) modal = hideBtn.closest('.modal-overlay');
        hideModal(modal);
        return;
      }

      const overlay = e.target.closest('.modal-overlay');
      if (overlay && e.target === overlay) {
        hideModal(overlay);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        document.querySelectorAll('.modal-overlay:not(.hidden)').forEach(function (modal) {
          hideModal(modal);
        });
      }
    });
  })();
</script>

  

            <!-- KYC Verification -->
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">KYC Verification</h2>
                
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="font-medium text-gray-900 dark:text-white">Identity Verification</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Verify your identity to unlock all features</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-medium 
                        <%= user.kycStatus === 'verified' ? 'bg-green-100 text-green-800' : 
                           user.kycStatus === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                           'bg-gray-100 text-gray-800' %>">
                        <%= user.kycStatus.charAt(0).toUpperCase() + user.kycStatus.slice(1) %>
                    </span>
                </div>

                <% if (user.kycStatus !== 'verified') { %>
                <form action="/client/kyc/upload" method="POST" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Document Type</label>
                        <select name="documentType" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white" required>
                            <option value="">Select Document Type</option>
                            <option value="passport">Passport</option>
                            <option value="id_card">National ID Card</option>
                            <option value="drivers_license">Driver's License</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Upload Document</label>
                        <div class="flex items-center justify-center w-full">
                            <label for="document" class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 dark:bg-gray-700 dark:border-gray-600">
                                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                    <svg class="w-8 h-8 mb-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                                    </svg>
                                    <p class="mb-2 text-sm text-gray-500 dark:text-gray-400"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">JPG, PNG, PDF (MAX. 5MB)</p>
                                </div>
                                <input id="document" name="document" type="file" class="hidden" required />
                            </label>
                        </div> 
                    </div>

                    <button type="submit" class="bg-crypto-blue text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                        Submit Verification
                    </button>
                </form>
                <% } else { %>
                <div class="bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-600 p-4 rounded-lg">
                    <p class="text-sm text-green-800 dark:text-green-200">
                        Your identity has been successfully verified. You now have access to all platform features.
                    </p>
                </div>
                <% } %>
            </div>
        </div>

    </div>
</main>

<%- include('../partials/footer') %>