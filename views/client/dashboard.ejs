<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-10 space-y-10">
    <div class="flex flex-col lg:flex-row justify-between items-center bg-gradient-to-r from-crypto-blue to-blue-600 rounded-2xl p-8 shadow-lg text-white">
        <div>
            <h1 class="text-3xl font-bold">Welcome back, <%= user.name %> 👋</h1>
            <p class="mt-2 text-sm opacity-90">Here’s a quick look at your investments today.</p>
        </div>
        <div class="flex space-x-4 mt-6 lg:mt-0">
            <button class="bg-white/20 backdrop-blur-lg px-5 py-2 rounded-lg hover:bg-white/30 transition">
                Quick Deposit
            </button>
            <button class="bg-green-500 px-5 py-2 rounded-lg hover:bg-green-600 transition">
                Invest Now
            </button>
        </div>
    </div>

    <!-- Portfolio Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Total Balance -->
        <div class="glassmorphism rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Balance</h3>
                    <p class="text-2xl font-bold text-gray-900 dark:text-white mt-2">
                        $<%= totalValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                    💰
                </div>
            </div>
            <p class="text-sm text-green-600 mt-3">+2.5% today</p>
        </div>

        <!-- Profit/Loss -->
        <div class="glassmorphism rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Profit / Loss</h3>
                    <p class="text-2xl font-bold text-gray-900 dark:text-white mt-2">+$1,245.32</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
                    📈
                </div>
            </div>
            <p class="text-sm text-blue-600 mt-3">+8.2% all time</p>
        </div>

        <!-- Active Investments -->
        <div class="glassmorphism rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Active Investments</h3>
                    <p class="text-2xl font-bold text-gray-900 dark:text-white mt-2">4</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center text-purple-600">
                    📊
                </div>
            </div>
            <p class="text-sm text-purple-600 mt-3">2 staking, 2 auto-invest</p>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Portfolio Performance</h3>
            <canvas id="performanceChart" height="300"></canvas>
        </div>
        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Asset Distribution</h3>
            <canvas id="assetChart" height="300"></canvas>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Recent Transactions</h3>
            <a href="/client/transactions" class="text-crypto-blue hover:underline">View All</a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Asset</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% transactions.forEach(transaction => { %>
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                <%= transaction.type === 'deposit' ? 'bg-green-100 text-green-800' : 
                                   transaction.type === 'withdrawal' ? 'bg-red-100 text-red-800' : 
                                   'bg-blue-100 text-blue-800' %>">
                                <%= transaction.type %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100"><%= transaction.asset %></td>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100"><%= transaction.amount %></td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                <%= transaction.status === 'completed' ? 'bg-green-100 text-green-800' : 
                                   transaction.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                                   'bg-red-100 text-red-800' %>">
                                <%= transaction.status %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100">
                            <%= new Date(transaction.createdAt).toLocaleDateString() %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Market Overview -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-6">Market Overview</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <% const coins = [
                {symbol: 'BTC', color: 'bg-yellow-500', price: '$41,235.67', change: '+2.4%'},
                {symbol: 'ETH', color: 'bg-indigo-500', price: '$2,235.12', change: '+1.8%'},
                {symbol: 'ADA', color: 'bg-red-500', price: '$0.98', change: '-0.7%'},
                {symbol: 'DOT', color: 'bg-purple-500', price: '$19.24', change: '+3.2%'}
            ]; %>
            <% coins.forEach(c => { %>
            <div class="p-4 rounded-xl shadow hover:shadow-lg transition bg-gray-100 dark:bg-gray-800">
                <div class="flex items-center">
                    <div class="w-10 h-10 <%= c.color %> rounded-full flex items-center justify-center text-white font-bold">
                        <%= c.symbol[0] %>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-gray-900 dark:text-white"><%= c.symbol %></p>
                        <p class="text-sm <%= c.change.includes('+') ? 'text-green-600' : 'text-red-600' %>">
                            <%= c.price %> <span class="text-xs"><%= c.change %></span>
                        </p>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
