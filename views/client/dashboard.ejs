<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Dashboard Overview</h1>
        <div class="flex space-x-4">
            <button class="bg-crypto-blue text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                Quick Deposit
            </button>
            <button class="bg-crypto-green text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-colors">
                Invest Now
            </button>
        </div>
    </div>

    <!-- Portfolio Summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Total Balance</h3>
                <span class="text-2xl font-bold text-crypto-green">$<%= totalValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">+2.5% today</p>
        </div>

        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Profit/Loss</h3>
                <span class="text-2xl font-bold text-crypto-green">+$1,245.32</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">+8.2% all time</p>
        </div>

        <div class="glassmorphism rounded-2xl p-6 shadow-lg">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Active Investments</h3>
                <span class="text-2xl font-bold text-crypto-blue">4</span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">2 staking, 2 auto-invest</p>
        </div>
    </div>

    <!-- Chart and Assets -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <!-- Performance Chart -->
        <div class="glassmorphism rounded-2xl p-6 shadow-lg lg:col-span-1">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Portfolio Performance</h3>
            <canvas id="performanceChart" height="300"></canvas>
        </div>

        <!-- Asset Distribution -->
        <div class="glassmorphism rounded-2xl p-6 shadow-lg lg:col-span-1">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Asset Distribution</h3>
            <canvas id="assetChart" height="300"></canvas>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg mb-8">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Recent Transactions</h3>
            <a href="/client/transactions" class="text-crypto-blue hover:underline">View All</a>
        </div>
        
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead>
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Asset</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% transactions.forEach(transaction => { %>
                    <tr>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                <%= transaction.type === 'deposit' ? 'bg-green-100 text-green-800' : 
                                   transaction.type === 'withdrawal' ? 'bg-red-100 text-red-800' : 
                                   'bg-blue-100 text-blue-800' %>">
                                <%= transaction.type %>
                            </span>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                            <%= transaction.asset %>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                            <%= transaction.amount %>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                <%= transaction.status === 'completed' ? 'bg-green-100 text-green-800' : 
                                   transaction.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                                   'bg-red-100 text-red-800' %>">
                                <%= transaction.status %>
                            </span>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                            <%= new Date(transaction.createdAt).toLocaleDateString() %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Market Overview Widget -->
    <div class="glassmorphism rounded-2xl p-6 shadow-lg">
        <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Market Overview</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-yellow-500 rounded-full flex items-center justify-center mr-3">
                        <span class="text-white font-bold">B</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">BTC</p>
                        <p class="text-sm text-green-600">$41,235.67 <span class="text-xs">+2.4%</span></p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-gray-400 rounded-full flex items-center justify-center mr-3">
                        <span class="text-white font-bold">E</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">ETH</p>
                        <p class="text-sm text-green-600">$2,235.12 <span class="text-xs">+1.8%</span></p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-red-500 rounded-full flex items-center justify-center mr-3">
                        <span class="text-white font-bold">A</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">ADA</p>
                        <p class="text-sm text-red-600">$0.98 <span class="text-xs">-0.7%</span></p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center mr-3">
                        <span class="text-white font-bold">D</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-900 dark:text-white">DOT</p>
                        <p class="text-sm text-green-600">$19.24 <span class="text-xs">+3.2%</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Performance Chart
    const performanceCtx = document.getElementById('performanceChart').getContext('2d');
    new Chart(performanceCtx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [{
                label: 'Portfolio Value',
                data: [12000, 19000, 15000, 25000, 22000, 30000, 28000, 33000, 38000, 42000, 45000, 48000],
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: false,
                    grid: {
                        color: 'rgba(255, 255, 255, 0.1)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // Asset Distribution Chart
    const assetCtx = document.getElementById('assetChart').getContext('2d');
    new Chart(assetCtx, {
        type: 'doughnut',
        data: {
            labels: ['Bitcoin', 'Ethereum', 'Cardano', 'Polkadot', 'Other'],
            datasets: [{
                data: [40, 25, 15, 12, 8],
                backgroundColor: [
                    '#f59e0b',
                    '#4f46e5',
                    '#10b981',
                    '#8b5cf6',
                    '#6b7280'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'right'
                }
            }
        }
    });
</script>

<%- include('../partials/footer') %>