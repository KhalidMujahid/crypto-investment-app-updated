<%- include('../partials/head', {title: title}) %>
<%- include('../partials/client-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Welcome back, <%= user.firstName %></h2>
      <p class="page-sub">Here's a snapshot of your portfolio and recent activity.</p>
    </div>
    <a href="/client/withdraw" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75"/></svg>
      Withdraw funds
    </a>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card card-body">
      <p class="text-sm font-medium muted">Portfolio value</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        $<%= totalValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </p>
      <p class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
        All accounts
      </p>
    </div>

    <div class="card card-body">
      <p class="text-sm font-medium muted">Active assets</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= wallets.length %></p>
      <p class="mt-1 text-xs muted">Wallets in your account</p>
    </div>

    <div class="card card-body">
      <p class="text-sm font-medium muted">Recent transactions</p>
      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= transactions.length %></p>
      <p class="mt-1 text-xs muted">Latest activity</p>
    </div>

    <div class="card card-body">
      <p class="text-sm font-medium muted">Verification</p>
      <p class="mt-2">
        <span class="badge <%= user.kycStatus === 'verified' ? 'badge-success' : user.kycStatus === 'pending' ? 'badge-warning' : user.kycStatus === 'rejected' ? 'badge-danger' : 'badge-neutral' %>">
          <%= user.kycStatus.replace('_', ' ') %>
        </span>
      </p>
      <a href="/client/profile" class="mt-2 inline-block text-xs font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">Manage KYC</a>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Recent transactions -->
    <div class="card lg:col-span-2">
      <div class="card-header">
        <h3 class="card-title">Recent transactions</h3>
        <a href="/client/transactions" class="text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">View all</a>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Asset</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% if (transactions.length === 0) { %>
              <tr><td colspan="5" class="text-center muted">No transactions yet.</td></tr>
            <% } %>
            <% transactions.forEach(function (transaction) { %>
              <tr>
                <td>
                  <span class="badge <%= transaction.type === 'deposit' ? 'badge-success' : transaction.type === 'withdrawal' ? 'badge-danger' : 'badge-info' %>"><%= transaction.type %></span>
                </td>
                <td class="font-medium text-slate-900 dark:text-white"><%= transaction.asset %></td>
                <td><%= transaction.amount %></td>
                <td>
                  <span class="badge <%= transaction.status === 'completed' ? 'badge-success' : transaction.status === 'pending' ? 'badge-warning' : 'badge-danger' %>"><%= transaction.status %></span>
                </td>
                <td class="whitespace-nowrap muted"><%= new Date(transaction.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Wallets -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">My wallets</h3>
      </div>
      <div class="card-body space-y-4">
        <% if (wallets.length === 0) { %>
          <p class="text-center text-sm muted">No wallets yet.</p>
        <% } %>
        <% wallets.forEach(function (wallet) { %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= wallet.currency.substring(0, 2) %></span>
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white"><%= wallet.currency %></p>
                <p class="text-xs muted">Available</p>
              </div>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white"><%= wallet.balance %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
