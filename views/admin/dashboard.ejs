<%- include('../partials/head', {title: title}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Admin dashboard</h2>
      <p class="page-sub">Platform overview and pending work.</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="card card-body">
      <div class="flex items-center gap-4">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z"/></svg>
        </span>
        <div>
          <p class="text-sm muted">Total users</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white"><%= stats.userCount %></p>
        </div>
      </div>
    </div>

    <div class="card card-body">
      <div class="flex items-center gap-4">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
        </span>
        <div>
          <p class="text-sm muted">Pending KYC</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white"><%= stats.pendingKyc %></p>
        </div>
      </div>
    </div>

    <div class="card card-body">
      <div class="flex items-center gap-4">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75"/></svg>
        </span>
        <div>
          <p class="text-sm muted">Pending withdrawals</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white"><%= stats.pendingWithdrawals %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick actions -->
  <div class="card mt-6">
    <div class="card-header"><h3 class="card-title">Quick actions</h3></div>
    <div class="card-body grid grid-cols-2 gap-4 md:grid-cols-4">
      <% [
        { name: 'User management', href: '/admin/users', icon: 'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z' },
        { name: 'Withdrawals', href: '/admin/withdrawals', icon: 'M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75' },
        { name: 'Transactions', href: '/admin/transactions', icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z' },
        { name: 'KYC review', href: '/admin/users/kyc/pending', icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' }
      ].forEach(function (action) { %>
        <a href="<%= action.href %>" class="flex flex-col items-center gap-3 rounded-xl border border-slate-200 p-5 text-center transition hover:border-brand-300 hover:bg-brand-50/50 dark:border-slate-800 dark:hover:border-brand-500/40 dark:hover:bg-brand-500/5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="<%= action.icon %>"/></svg>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-200"><%= action.name %></span>
        </a>
      <% }); %>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Recent signups</h3></div>
      <div class="card-body space-y-3">
        <% for (let i = 0; i < 5; i++) { %>
          <div class="flex items-center justify-between rounded-xl border border-slate-100 px-4 py-3 dark:border-slate-800">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">U<%= i + 1 %></span>
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white">User <%= i + 1234 %></p>
                <p class="text-xs muted">2 hours ago</p>
              </div>
            </div>
            <span class="badge badge-brand">New</span>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">System health</h3></div>
      <div class="card-body space-y-5">
        <% [
          { label: 'API response', value: '98%', width: '98%' },
          { label: 'Server uptime', value: '99.9%', width: '99.9%' },
          { label: 'Database', value: 'Normal', width: '100%' },
          { label: 'Transactions/sec', value: '124', width: '75%' }
        ].forEach(function (row) { %>
          <div>
            <div class="mb-1.5 flex items-center justify-between text-sm">
              <span class="muted"><%= row.label %></span>
              <span class="font-medium text-emerald-600 dark:text-emerald-400"><%= row.value %></span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800">
              <div class="h-2 rounded-full bg-emerald-500" style="width: <%= row.width %>"></div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
