<%- include('../partials/head', {title: title || 'Users'}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Users</h2>
      <p class="page-sub">All registered accounts across the platform.</p>
    </div>
    <span class="badge badge-neutral"><%= users.length %> total</span>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>KYC</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!users || users.length === 0) { %>
            <tr><td colspan="6" class="text-center muted">No users found.</td></tr>
          <% } %>
          <% (users || []).forEach(function (u) { %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white">
                    <%= (u.firstName ? u.firstName[0] : '') %><%= (u.lastName ? u.lastName[0] : '') %>
                  </span>
                  <span class="font-medium text-slate-900 dark:text-white"><%= u.firstName %> <%= u.lastName %></span>
                </div>
              </td>
              <td class="muted"><%= u.email %></td>
              <td><span class="badge <%= u.role === 'admin' ? 'badge-brand' : 'badge-neutral' %>"><%= u.role %></span></td>
              <td>
                <span class="badge <%= u.kycStatus === 'verified' ? 'badge-success' : u.kycStatus === 'pending' ? 'badge-warning' : u.kycStatus === 'rejected' ? 'badge-danger' : 'badge-neutral' %>">
                  <%= u.kycStatus.replace('_', ' ') %>
                </span>
              </td>
              <td>
                <span class="badge <%= u.status === 'active' ? 'badge-success' : u.status === 'suspended' ? 'badge-warning' : 'badge-danger' %>"><%= u.status %></span>
              </td>
              <td class="text-right">
                <a href="/admin/users/<%= u._id %>" class="text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400">View details</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
