<%- include('../partials/head', {title: 'Pending KYC'}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">KYC review queue</h2>
      <p class="page-sub">Verification requests awaiting approval.</p>
    </div>
    <span class="badge <%= users.length > 0 ? 'badge-warning' : 'badge-success' %>"><%= users.length %> pending</span>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Submitted</th><th class="text-right">Action</th></tr>
        </thead>
        <tbody>
          <% if (!users || users.length === 0) { %>
            <tr><td colspan="4" class="text-center muted">No pending requests at the moment.</td></tr>
          <% } %>
          <% (users || []).forEach(function (u) { %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white">
                    <%= (u.firstName ? u.firstName[0] : '') %><%= (u.lastName ? u.lastName[0] : '') %>
                  </span>
                  <span class="font-medium text-slate-900 dark:text-white"><%= u.firstName %> <%= u.lastName %></span>
                </div>
              </td>
              <td class="muted"><%= u.email %></td>
              <td class="muted"><%= u.kycSubmittedAt ? new Date(u.kycSubmittedAt).toLocaleDateString() : '—' %></td>
              <td class="text-right">
                <a href="/admin/users/<%= u._id %>/kyc" class="btn btn-primary btn-sm">Review</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
