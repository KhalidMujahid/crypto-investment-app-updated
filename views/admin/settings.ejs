<%- include('../partials/head', {title: title}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">System settings</h2>
      <p class="page-sub">Platform configuration, fees and deposit wallets.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Forms -->
    <div class="space-y-6 lg:col-span-2">

      <div class="card">
        <div class="card-header"><h3 class="card-title">General</h3></div>
        <div class="card-body">
          <form action="/admin/settings" method="POST" class="space-y-5">
            <div>
              <label class="label">Platform name</label>
              <input type="text" value="Advanced Trading" class="input">
            </div>
            <div>
              <label class="label">Support email</label>
              <input type="email" value="support@advancedtrading.com" class="input">
            </div>
            <div>
              <label class="label">Default currency</label>
              <select class="input">
                <option>USD</option><option>EUR</option><option>GBP</option><option>JPY</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Save general settings</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">Fees</h3></div>
        <div class="card-body">
          <form action="/admin/settings" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label class="label">Deposit fee (%)</label>
                <input type="number" step="0.01" value="0.5" class="input">
              </div>
              <div>
                <label class="label">Withdrawal fee (%)</label>
                <input type="number" step="0.01" value="1.0" class="input">
              </div>
              <div>
                <label class="label">Trade fee (%)</label>
                <input type="number" step="0.01" value="0.25" class="input">
              </div>
              <div>
                <label class="label">Minimum withdrawal</label>
                <input type="number" step="0.00000001" value="0.001" class="input">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Save fee settings</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">Deposit wallet</h3></div>
        <div class="card-body">
          <form action="/admin/wallet/update" method="POST" class="space-y-5">
            <div>
              <label class="label">Currency</label>
              <select name="currency" class="input" required>
                <option value="">Select currency</option>
                <option value="BTC">Bitcoin (BTC)</option>
                <option value="ETH">Ethereum (ETH)</option>
                <option value="USDT">USDT (ERC20)</option>
                <option value="USDT_TRC20">USDT (TRC20)</option>
                <option value="ADA">Cardano (ADA)</option>
                <option value="DOT">Polkadot (DOT)</option>
              </select>
            </div>
            <div>
              <label class="label">Deposit address</label>
              <input type="text" name="address" class="input font-mono" placeholder="Enter new deposit address" required>
            </div>
            <button type="submit" class="btn btn-primary">Update wallet address</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Side -->
    <div class="space-y-6">
      <div class="card">
        <div class="card-header"><h3 class="card-title">System status</h3></div>
        <div class="card-body space-y-5">
          <% [
            { label: 'API response', value: '98%', width: '98%' },
            { label: 'Server uptime', value: '99.9%', width: '99.9%' },
            { label: 'Database', value: 'Normal', width: '100%' }
          ].forEach(function (row) { %>
            <div>
              <div class="mb-1.5 flex items-center justify-between text-sm">
                <span class="muted"><%= row.label %></span>
                <span class="font-medium text-emerald-600 dark:text-emerald-400"><%= row.value %></span>
              </div>
              <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800">
                <div class="h-2 rounded-full bg-emerald-500" style="width: <%= row.width %>"></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">Security</h3></div>
        <div class="card-body space-y-4">
          <% [
            { label: 'Force 2FA', checked: true },
            { label: 'Email verification', checked: true },
            { label: 'KYC required', checked: true },
            { label: 'Withdrawal email confirm', checked: true }
          ].forEach(function (item) { %>
            <label class="flex items-center justify-between gap-4">
              <span class="text-sm text-slate-600 dark:text-slate-300"><%= item.label %></span>
              <span class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" class="peer sr-only" <%= item.checked ? 'checked' : '' %>>
                <span class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-brand-600 dark:bg-slate-700"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
              </span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title text-rose-600 dark:text-rose-400">Danger zone</h3></div>
        <div class="card-body space-y-3">
          <button class="btn btn-warning w-full">Enable maintenance mode</button>
          <button class="btn btn-danger w-full">Emergency shutdown</button>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
