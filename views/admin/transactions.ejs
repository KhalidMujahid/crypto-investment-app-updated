<%- include('../partials/head', {title: title}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Transaction oversight</h2>
      <p class="page-sub">Every transaction across the platform.</p>
    </div>
    <span class="badge badge-neutral"><%= total %> total</span>
  </div>

  <!-- Filters -->
  <div class="card mb-6">
    <div class="card-body grid grid-cols-1 gap-4 md:grid-cols-4">
      <div>
        <label class="label">Search</label>
        <input type="text" class="input" placeholder="Address, user, hash…">
      </div>
      <div>
        <label class="label">Type</label>
        <select class="input">
          <option value="">All types</option>
          <option value="deposit">Deposit</option>
          <option value="withdrawal">Withdrawal</option>
          <option value="trade">Trade</option>
          <option value="staking">Staking</option>
        </select>
      </div>
      <div>
        <label class="label">Status</label>
        <select class="input">
          <option value="">All statuses</option>
          <option value="completed">Completed</option>
          <option value="pending">Pending</option>
          <option value="processing">Processing</option>
          <option value="failed">Failed</option>
        </select>
      </div>
      <div>
        <label class="label">Date range</label>
        <select class="input">
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
          <option value="90">Last 90 days</option>
          <option value="all">All time</option>
        </select>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Date</th>
            <th>User</th>
            <th>Type</th>
            <th>Asset</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr><td colspan="6" class="text-center muted">No transactions found.</td></tr>
          <% } %>
          <% transactions.forEach(function (transaction) { %>
            <tr>
              <td class="whitespace-nowrap muted"><%= new Date(transaction.createdAt).toLocaleDateString() %></td>
              <td>
                <div class="flex items-center gap-3">
                  <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                    <%= transaction.user ? (transaction.user.firstName || '?')[0] : '?' %><%= transaction.user ? (transaction.user.lastName || '?')[0] : '' %>
                  </span>
                  <div>
                    <p class="text-sm font-medium text-slate-900 dark:text-white"><%= transaction.user ? transaction.user.firstName + ' ' + transaction.user.lastName : 'Unknown' %></p>
                    <p class="text-xs muted"><%= transaction.user ? transaction.user.email : '' %></p>
                  </div>
                </div>
              </td>
              <td><span class="badge <%= transaction.type === 'deposit' ? 'badge-success' : transaction.type === 'withdrawal' ? 'badge-danger' : 'badge-info' %>"><%= transaction.type %></span></td>
              <td class="font-medium text-slate-900 dark:text-white"><%= transaction.asset %></td>
              <td><%= transaction.amount %></td>
              <td><span class="badge <%= transaction.status === 'completed' ? 'badge-success' : transaction.status === 'pending' ? 'badge-warning' : transaction.status === 'processing' ? 'badge-info' : 'badge-danger' %>"><%= transaction.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 px-5 py-4 dark:border-slate-800">
        <p class="text-sm muted">Page <%= currentPage %> of <%= totalPages %></p>
        <div class="flex items-center gap-1">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>" class="btn btn-secondary btn-sm">Previous</a>
          <% } %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>" class="btn btn-sm <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %>"><%= i %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>" class="btn btn-secondary btn-sm">Next</a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
