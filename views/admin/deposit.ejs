<%- include('../partials/head', {title: title || 'Deposit'}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Deposit funds</h2>
      <p class="page-sub">Platform deposit configuration.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-2">
      <div class="card-header"><h3 class="card-title">Deposit cryptocurrency</h3></div>
      <div class="card-body">
        <div class="max-w-md">
          <label class="label">Asset</label>
          <select class="input">
            <option>Bitcoin (BTC)</option>
            <option>Ethereum (ETH)</option>
            <option>USDT (ERC20)</option>
            <option>USDT (TRC20)</option>
            <option>Cardano (ADA)</option>
            <option>Polkadot (DOT)</option>
          </select>
        </div>
        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
          Send only the selected asset to this address.
        </div>
      </div>
    </div>

    <div class="card card-body">
      <h3 class="card-title">Fiat deposit</h3>
      <p class="mt-2 text-sm muted">Process a manual fiat deposit for a user.</p>
      <button class="btn btn-primary mt-4 w-full">Process fiat deposit</button>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
