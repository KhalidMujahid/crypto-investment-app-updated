<%- include('../partials/head', {title: title}) %>
<%- include('../partials/admin-header') %>

<main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Deposit Funds</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Deposit Methods -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Crypto Deposit -->
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Deposit Cryptocurrency</h2>
                
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Currency</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-crypto-blue focus:border-crypto-blue dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                        <option>Bitcoin (BTC)</option>
                        <option>Ethereum (ETH)</option>
                        <option>USDT (ERC20)</option>
                        <option>USDT (TRC20)</option>
                        <option>Cardano (ADA)</option>
                        <option>Polkadot (DOT)</option>
                    </select>
                </div>

                <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg mb-4">
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Send only <span class="font-medium">BTC</span> to this address</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Sending any other currency may result in permanent loss</p>
                </div>
            </div>

            <!-- Fiat Deposit -->
            <div class="glassmorphism rounded-2xl p-6 shadow-lg">
                <button class="w-full bg-crypto-blue text-white py-3 rounded-lg hover:bg-blue-600 transition-colors">
                    Process Fiat Deposit
                </button>
            </div>
        </div>


    </div>
</main>

<%- include('../partials/footer') %>