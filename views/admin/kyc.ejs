<%- include('../partials/head', {title: 'KYC Verification'}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div class="flex items-center gap-4">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white">
        <%= (user.firstName ? user.firstName[0] : '') %><%= (user.lastName ? user.lastName[0] : '') %>
      </span>
      <div>
        <h2 class="page-title"><%= user.firstName %> <%= user.lastName %></h2>
        <p class="page-sub">KYC verification review</p>
      </div>
    </div>
    <a href="/admin/users/kyc/pending" class="btn btn-secondary btn-sm">&larr; Queue</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Info -->
    <div class="card lg:col-span-2">
      <div class="card-header"><h3 class="card-title">Applicant</h3></div>
      <div class="card-body grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide muted">Full name</dt>
          <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-white"><%= user.firstName %> <%= user.lastName %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide muted">Email</dt>
          <dd class="mt-1 text-sm text-slate-800 dark:text-slate-200"><%= user.email %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide muted">Submitted</dt>
          <dd class="mt-1 text-sm text-slate-800 dark:text-slate-200"><%= user.kycSubmittedAt ? new Date(user.kycSubmittedAt).toLocaleString() : '—' %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide muted">Current status</dt>
          <dd class="mt-1">
            <span class="badge <%= user.kycStatus === 'verified' ? 'badge-success' : user.kycStatus === 'pending' ? 'badge-warning' : user.kycStatus === 'rejected' ? 'badge-danger' : 'badge-neutral' %>"><%= user.kycStatus.replace('_', ' ') %></span>
          </dd>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="card">
      <div class="card-header"><h3 class="card-title">Decision</h3></div>
      <div class="card-body">
        <% if (user.kycNotes) { %>
          <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950/50 dark:text-slate-300">
            <span class="font-medium">Previous notes:</span> <%= user.kycNotes %>
          </div>
        <% } %>

        <form action="/admin/users/<%= user._id %>/kyc/update" method="POST" class="space-y-4">
          <div>
            <label for="notes" class="label">Admin notes (optional)</label>
            <textarea id="notes" name="notes" rows="3" class="input" placeholder="Add a note for the user…"></textarea>
          </div>
          <button type="submit" name="action" value="approve" class="btn btn-success w-full">Approve</button>
          <button type="submit" name="action" value="reject" class="btn btn-danger w-full">Reject</button>
          <button type="submit" name="action" value="pending" class="btn btn-secondary w-full">Mark pending</button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
