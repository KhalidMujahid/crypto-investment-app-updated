<%- include('../partials/head', {title: title}) %>
<%- include('../partials/admin-header') %>

<main class="page">

  <div class="page-head">
    <div>
      <h2 class="page-title">Withdrawal requests</h2>
      <p class="page-sub">Review and process pending withdrawal requests.</p>
    </div>
    <span class="badge <%= withdrawals.length > 0 ? 'badge-warning' : 'badge-success' %>"><%= withdrawals.length %> pending</span>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">Pending requests</h3></div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>User</th>
            <th>Asset</th>
            <th>Amount</th>
            <th>Address</th>
            <th>Requested</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% withdrawals.forEach(function (withdrawal) { %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white">
                    <%= withdrawal.user.firstName.charAt(0) %><%= withdrawal.user.lastName.charAt(0) %>
                  </span>
                  <div>
                    <p class="font-medium text-slate-900 dark:text-white"><%= withdrawal.user.firstName %> <%= withdrawal.user.lastName %></p>
                    <p class="text-xs muted"><%= withdrawal.user.email %></p>
                  </div>
                </div>
              </td>
              <td class="font-medium text-slate-900 dark:text-white"><%= withdrawal.asset %></td>
              <td><%= withdrawal.amount %></td>
              <td class="font-mono text-xs muted"><%= withdrawal.address.substring(0, 8) %>…<%= withdrawal.address.substring(withdrawal.address.length - 8) %></td>
              <td class="whitespace-nowrap muted"><%= new Date(withdrawal.createdAt).toLocaleDateString() %></td>
              <td>
                <div class="flex items-center justify-end gap-2">
                  <form action="/admin/withdrawals/<%= withdrawal._id %>/process" method="POST">
                    <input type="hidden" name="action" value="approve">
                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                  </form>
                  <form action="/admin/withdrawals/<%= withdrawal._id %>/process" method="POST">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (withdrawals.length === 0) { %>
      <div class="empty">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </span>
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">No pending withdrawals</p>
        <p class="text-sm muted">All requests have been processed.</p>
      </div>
    <% } %>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="card card-body">
      <h3 class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">Approve</h3>
      <p class="mt-1 text-sm muted">Release legitimate requests after verifying identity and destination details.</p>
    </div>
    <div class="card card-body">
      <h3 class="text-sm font-semibold text-amber-600 dark:text-amber-400">Hold</h3>
      <p class="mt-1 text-sm muted">Keep suspicious requests pending for further investigation.</p>
    </div>
    <div class="card card-body">
      <h3 class="text-sm font-semibold text-rose-600 dark:text-rose-400">Reject</h3>
      <p class="mt-1 text-sm muted">Reject requests that breach terms or appear fraudulent — funds return to the user.</p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
