<%- include('partials/head', { title: 'Something went wrong', bodyClass: 'bg-slate-100 dark:bg-slate-950' }) %>

<main class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg">
    <div class="card overflow-hidden">
      <div class="card-body text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>

        <h1 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Something went wrong</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          <%= (error && error.message) ? error.message : "An unexpected error occurred. Please try again." %>
        </p>

        <% if (error && error.stack) { %>
          <details class="mt-5 text-left">
            <summary class="cursor-pointer text-xs font-medium text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">Technical details</summary>
            <pre class="mt-2 max-h-56 overflow-auto rounded-lg bg-slate-900 p-4 text-left text-xs leading-relaxed text-slate-300"><%= error.stack %></pre>
          </details>
        <% } %>

        <div class="mt-7 flex justify-center gap-3">
          <button onclick="history.back()" class="btn btn-secondary">Go back</button>
          <a href="/" class="btn btn-primary">Back to home</a>
        </div>
      </div>
    </div>
  </div>
</main>

</body>
</html>
